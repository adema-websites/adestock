---
// Layout de tutoriales y ayuda: usa el layout común de páginas, con los estilos propios del lector de guías.
import '../styles/tutoriales.css';
import Pagina from './Pagina.astro';

interface Props {
  title: string;
  description: string;
  path: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  ogImage?: string | null;
  jsonLd?: object[];
}
const props = Astro.props;
---
<Pagina {...props}>
  <slot />
</Pagina>
