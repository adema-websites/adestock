---
import '../styles/marca.css';
import { ClientRouter } from 'astro:transitions';
import { SITE } from '../lib/tutoriales';

interface Props {
  title: string;
  description: string;
  path: string;
  noindex?: boolean;
  ogImage?: string;
  ogType?: 'website' | 'article';
  jsonLd?: object[];
}
const { title, description, path, noindex = false, ogImage = '/social/adestock-v1.jpg', ogType = 'website', jsonLd = [] } = Astro.props;
const canonical = SITE + path;
const img = SITE + ogImage;
const GA = 'G-W01VQ5GZND';
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow,max-image-preview:large,max-snippet:-1'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="alternate" type="text/plain" href={`${SITE}/llms.txt`} title="ADEstock LLM instructions" />
    <meta property="og:site_name" content="ADEstock" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={img} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={img} />
    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
    <ClientRouter />
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA}`}></script>
    <script is:inline define:vars={{ GA }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date()); gtag('config', GA);
    </script>
  </head>
  <body>
    <a class="skip" href="#contenido">Ir al contenido</a>
    <slot />
  </body>
</html>
