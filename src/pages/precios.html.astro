---
import Pagina from '../layouts/Pagina.astro';

const wa = (t: string) => `https://wa.me/5491127888995?text=${encodeURIComponent(t)}`;
const DEMO = 'https://demo.adestock.com.ar/';
const planes = [
  { id: 'anual', nombre: 'Plan anual 10 x 12', precio: '$ 1.200.000', per: 'IVA incluido / año', detalle: 'Pagás 10, usás 12', items: ['12 meses de uso al precio de 10', 'Equivale a $ 100.000 por mes', 'Hosting y copias de seguridad incluidos', 'Soporte técnico por WhatsApp'], cta: 'Quiero la anual', msg: 'Hola, me interesa el Plan anual 10 x 12 de ADEstock Web ($1.200.000 IVA incluido). ¿Cómo avanzamos?' },
  { id: 'lifetime', nombre: 'Pago único', precio: 'Consultar', per: 'una sola vez', detalle: 'De por vida', items: ['Un solo pago, uso sin límite de tiempo', 'Sin renovaciones mensuales ni anuales', 'Licencia perpetua', 'Soporte estándar'], cta: 'Consultar precio', msg: 'Hola, quiero saber el precio del pago único (licencia de por vida) de ADEstock.' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'ADEstock',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web',
    url: 'https://adestock.com.ar/',
    offers: [
      { '@type': 'Offer', name: 'ADEstock Web (mensual)', price: '120000', priceCurrency: 'ARS', priceSpecification: { '@type': 'UnitPriceSpecification', price: '120000', priceCurrency: 'ARS', valueAddedTaxIncluded: true, unitText: 'MON' }, url: 'https://adestock.com.ar/precios.html' },
      { '@type': 'Offer', name: 'ADEstock Web (anual, 10 x 12)', price: '1200000', priceCurrency: 'ARS', priceSpecification: { '@type': 'UnitPriceSpecification', price: '1200000', priceCurrency: 'ARS', valueAddedTaxIncluded: true, unitText: 'ANN' }, url: 'https://adestock.com.ar/precios.html' },
    ],
  },
];
---
<Pagina
  title="Precios de ADEstock | Sistema de stock para comercios"
  description="Consultá los planes de ADEstock para controlar stock, inventario, ventas, caja, compras y reportes en comercios argentinos. Demo online y licencia web mensual o anual."
  path="/precios.html"
  jsonLd={jsonLd}
>
  <div class="crumbs"><a href="/">Inicio</a>{' / '}Precios</div>
  <main id="contenido">
    <header class="page-hero">
      <div class="page-hero__inner">
        <h1>Elegí cómo querés usar ADEstock</h1>
        <p class="page-lead">Licencia web: entrás desde cualquier navegador, sin instalar nada. Precios en pesos argentinos, IVA incluido, sin costos ocultos.</p>
      </div>
    </header>

    <section class="band" aria-labelledby="web">
      <div class="seo-hero__inner">
        <div class="cols-3">
          <article class="card dark" id="mensual" style="grid-column: span 1">
            <span class="tag">Promo octubre: 40 % off</span>
            <h2 id="web" style="font-size:1.6rem">ADEstock Web</h2>
            <p class="price" style="color:var(--night-ink)">$ 72.000 <small style="color:inherit; opacity:.75">IVA incluido / mes · primeros 3 meses</small></p>
            <p style="margin-top:.25rem">Después, precio regular: <strong>$ 120.000 por mes</strong>, IVA incluido.</p>
            <ul class="check-list">
              <li>Acceso 24/7 desde cualquier navegador</li>
              <li>Hosting incluido: nosotros lo alojamos</li>
              <li>Copias de seguridad automáticas diarias</li>
              <li>Actualizaciones automáticas</li>
              <li>Varios usuarios al mismo tiempo</li>
              <li>Soporte prioritario</li>
            </ul>
            <p class="muted" style="margin-top:.5rem; color:inherit; opacity:.8; font-size:.9rem">Promoción válida únicamente para contrataciones realizadas en octubre de 2026.</p>
            <div class="actions">
              <a class="btn btn-primary btn-sobre-noche" href={wa('Hola ADEstock, me interesa la licencia web con la promo de octubre (40 % off los primeros 3 meses, luego $120.000 por mes IVA incluido). ¿Podemos avanzar?')}>Aprovechar la promo</a>
            </div>
          </article>
          {planes.map((p) => (
            <article class="card" id={p.id}>
              <span class="tag" style="justify-self:start; margin:0">{p.detalle}</span>
              <h3>{p.nombre}</h3>
              <p class="price">{p.precio} <small>{p.per}</small></p>
              <ul class="check-list">{p.items.map((i) => <li>{i}</li>)}</ul>
              <div class="actions" style="margin-top:.5rem">
                <a class="btn btn-ghost" href={wa(p.msg)}>{p.cta}</a>
              </div>
            </article>
          ))}
        </div>
        <p class="muted" style="margin-top:1.25rem">Todos los valores incluyen IVA. Para el pago único, escribinos y te pasamos el precio vigente.</p>
      </div>
    </section>

    <section class="band alt">
      <div class="seo-hero__inner">
        <h2 style="max-width: 24ch">¿No sabés cuál te conviene?</h2>
        <p class="page-lead">Probá la demo online, sin instalar nada, o escribinos y lo vemos según tu negocio.</p>
        <div class="actions">
          <a class="btn btn-primary" href={DEMO}>Probar la demo</a>
          <a class="btn btn-ghost" href="/contacto.html">Hablar con el equipo</a>
        </div>
      </div>
    </section>
  </main>
</Pagina>

<style is:global>
  .btn-sobre-noche { background: #4fc3d6; color: #06222a; }
  .btn-sobre-noche:hover { background: #7fd6e4; }
</style>
