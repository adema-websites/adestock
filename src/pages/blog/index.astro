---
// Migrada desde public/blog/index.html. El contenido vive en src/paginas/blog.html.
import Pagina from '../../layouts/Pagina.astro';
import contenido from '../../paginas/blog.html?raw';
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": "https://adestock.com.ar/#organization",
        "name": "ADEMA Sistemas",
        "url": "https://adestock.com.ar/",
        "logo": "https://adestock.com.ar/img/logo.png"
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Inicio",
            "item": "https://adestock.com.ar/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Blog",
            "item": "https://adestock.com.ar/blog/"
          }
        ]
      }
    ]
  }
];
---
<Pagina
  title={"Guías de stock, inventario y ventas | Blog ADEstock"}
  description={"Guías prácticas de ADEstock para controlar stock, inventario, compras, reposición, caja y ventas en kioscos, almacenes, minimarkets y pymes."}
  path="/blog/"
  ogType="website"
  jsonLd={jsonLd}
>
  <Fragment set:html={contenido} />
</Pagina>
