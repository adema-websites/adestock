---
// El instalador de escritorio ya no se distribuye. Se conserva la URL vieja para no romper enlaces externos
// y se redirige a la demo online.
const DEMO = 'https://demo.adestock.com.ar/';
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <title>Demo de ADEstock</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={DEMO} />
    <meta http-equiv="refresh" content={`0; url=${DEMO}`} />
  </head>
  <body>
    <p>Redirigiendo a la <a href={DEMO}>demo online de ADEstock</a>…</p>
  </body>
</html>
